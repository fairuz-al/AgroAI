# AgroAI - Environment Configuration

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agroai

# Database URL (Default PostgreSQL for local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agroai
# Use SQLite locally (alternative fallback):
# DATABASE_URL=sqlite:///./agroai.db

# Google Gemini API Key for Reasoning AI (Optional, falls back to programmatic reasoning if empty)
GEMINI_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
